# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database (MySQL) ----
# RECOMMENDED: paste a single connection string from PlanetScale / Railway / Clever Cloud here.
# The app auto-detects it. If it is empty, the local DB_* values below are used instead.
DATABASE_URL=
# Set to true for hosted MySQL providers that require SSL.
DB_SSL=false

# Local MySQL fallback (used only when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=budget_app
DB_USER=root
DB_PASSWORD=

# ---- Auth ----
JWT_SECRET=change_this_to_a_long_random_string
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---- Email (optional; if unset, reset emails are printed to the console) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_NAME=Budget App
FROM_EMAIL=no-reply@example.com

# ---- WhatsApp Cloud API (optional) ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
