# Frontend environment variables
# Copy this file to `.env` and fill in your own values.

# Google OAuth client ID used for "Sign in with Google"
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Base URL of the backend API (no trailing slash, no /api).
# Leave unset for local development -> defaults to http://localhost:5000
# For production set it to your deployed backend, e.g. https://smartbudget-api.onrender.com
VITE_API_URL=
